@model JourneySpire.Models.Route

@{
    ViewData["Title"] = "Edit Route";

    Layout = "_HomeLayout";
}

<h2>Edit Route</h2>
<hr />

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="RouteId" />

    <div class="mb-3">
        <label class="form-label">Source Location</label>
        <input asp-for="SourceLocation" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Destination Location</label>
        <input asp-for="DestinationLocation" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Distance (KM)</label>
        <input asp-for="DistanceKm" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estimated Time</label>
        <input asp-for="EstimatedTime" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Update
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
