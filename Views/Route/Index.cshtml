@model IEnumerable<JourneySpire.Models.Route>

@{
    ViewData["Title"] = "Route List";

    Layout = "_HomeLayout";
}

<h2>Route List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Route
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Source</th>
            <th>Destination</th>
            <th>Distance (KM)</th>
            <th>Estimated Time</th>
            <th width="180">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.SourceLocation</td>
                <td>@r.DestinationLocation</td>
                <td>@r.DistanceKm</td>
                <td>@r.EstimatedTime</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@r.RouteId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@r.RouteId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
