@model JourneySpire.Models.Schedule

@{
    ViewData["Title"] = "Delete Schedule";

    Layout = "_HomeLayout";
}

<h2>Delete Schedule</h2>
<hr />

<div class="alert alert-warning">
    Are you sure you want to delete this schedule?
</div>

<table class="table table-bordered">
    <tr>
        <th>Vehicle</th>
        <td>@Model.VehicleNumber</td>
    </tr>
    <tr>
        <th>Driver</th>
        <td>@Model.DriverName</td>
    </tr>
    <tr>
        <th>Route</th>
        <td>@Model.SourceLocation - @Model.DestinationLocation</td>
    </tr>
    <tr>
        <th>Date</th>
        <td>@Model.ScheduleDate.ToShortDateString()</td>
    </tr>
    <tr>
        <th>Time</th>
        <td>@Model.StartTime - @Model.EndTime</td>
    </tr>
</table>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ScheduleId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
