@model IEnumerable<JourneySpire.Models.Schedule>

@{
    ViewData["Title"] = "Vehicle Schedule";
    Layout = "_HomeLayout";
}

<h2>Vehicle Schedule</h2>
<a asp-action="Create" class="btn btn-primary mb-2">Create Schedule</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Vehicle</th>
            <th>Driver</th>
            <th>Route</th>
            <th>Date</th>
            <th>Time</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.VehicleNumber</td>
                <td>@s.DriverName</td>
                <td>@s.SourceLocation - @s.DestinationLocation</td>
                <td>@s.ScheduleDate.ToShortDateString()</td>
                <td>@s.StartTime - @s.EndTime</td>
                <td>@s.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.ScheduleId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@s.ScheduleId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
