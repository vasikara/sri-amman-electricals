@model JourneySpire.Models.Guide

@{
    ViewData["Title"] = "Delete Guide";

    Layout = "_HomeLayout";
}

<h2>Delete Guide</h2>

<h4>Are you sure you want to delete this guide?</h4>
<hr />

<div class="alert alert-danger">
    <strong>Guide Name:</strong> @Model.FullName <br />
    <strong>Phone:</strong> @Model.Phone <br />
    <strong>Language:</strong> @Model.Language <br />
    <strong>Status:</strong> @Model.Status
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="GuideId" />

    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
