@model JourneySpire.Models.Booking

@{
    ViewData["Title"] = "Booking Details";

    Layout = "_HomeLayout";
}

<h2>Booking Details</h2>
<hr />

<table class="table table-bordered">
    <tr>
        <th style="width:30%">Booking ID</th>
        <td>@Model.BookingId</td>
    </tr>

    <tr>
        <th>Package Name</th>
        <td>@Model.PackageName</td>
    </tr>

    <tr>
        <th>Customer Name</th>
        <td>@Model.CustomerName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Phone</th>
        <td>@Model.Phone</td>
    </tr>

    <tr>
        <th>Travel Date</th>
        <td>@Model.TravelDate.ToString("dd-MMM-yyyy")</td>
    </tr>

    <tr>
        <th>End Date</th>
        <td>@Model.EndDate.ToString("dd-MMM-yyyy")</td>
    </tr>

    <tr>
        <th>Number of Persons</th>
        <td>@Model.NumberOfPersons</td>
    </tr>

    <tr>
        <th>Price (per person)</th>
        <td>₹ @Model.Price</td>
    </tr>

    <tr>
        <th>Total Amount</th>
        <td><b>₹ @Model.TotalAmount</b></td>
    </tr>

    <tr>
        <th>Status</th>
        <td>
            @if (Model.BookingStatus == "Confirmed")
            {
                <span class="badge bg-success">Confirmed</span>
            }
            else if (Model.BookingStatus == "Cancelled")
            {
                <span class="badge bg-danger">Cancelled</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
        </td>
    </tr>

    <tr>
        <th>Created Date</th>
        <td>@Model.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")</td>
    </tr>
</table>

<a asp-action="Edit"
   asp-route-id="@Model.BookingId"
   class="btn btn-primary">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back to List
</a>
