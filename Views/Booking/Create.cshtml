@model JourneySpire.Models.Booking

@{
    ViewData["Title"] = "Create Booking";

    Layout = "_HomeLayout";
}

<h2>Create Booking</h2>
<hr />

<form asp-action="Create" method="post">
    <div class="row">

        <div class="col-md-6 mb-3">
            <label>Package Id</label>
            <input asp-for="PackageId" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Package Name</label>
            <input asp-for="PackageName" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Customer Name</label>
            <input asp-for="CustomerName" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Email</label>
            <input asp-for="Email" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Phone</label>
            <input asp-for="Phone" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Travel Date</label>
            <input asp-for="TravelDate" type="date" class="form-control" required/>
        </div>

        <div class="col-md-6 mb-3">
            <label>End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label>Number Of Persons</label>
            <input asp-for="NumberOfPersons"
                   id="persons"
                   class="form-control"
                   onkeyup="calculateTotal()" required/>
        </div>

        <div class="col-md-6 mb-3">
            <label>Price (per person)</label>
            <input asp-for="Price"
                   id="price"
                   class="form-control"
                   onkeyup="calculateTotal()" required />
        </div>

        <!-- 🔥 AUTO CALCULATED (PREVIEW ONLY) -->
        <div class="col-md-6 mb-3">
            <label>Total Amount</label>
            <input type="text"
                   id="TotalAmount"
                   class="form-control"
                   readonly />
        </div>

    </div>

    <button type="submit" class="btn btn-success">
        Confirm Booking
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form> 

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}


@section Scripts {
    <script>
        function calculateTotal() {
            var persons = document.getElementById("persons").value;
            var price = document.getElementById("price").value;

            if (persons && price) {
                document.getElementById("TotalAmount").value =
                    (persons * price).toFixed(2);
            } else {
                document.getElementById("TotalAmount").value = "";
            }
        }
    </script>
}
