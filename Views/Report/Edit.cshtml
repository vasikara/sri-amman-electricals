@model JourneySpire.Models.Report
@{
    ViewData["Title"] = "Edit Report";
    Layout = "_HomeLayout";
}

<h2>Edit Report</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ReportId" />

    <div class="mb-3">
        <label>Report Type</label>
        <input asp-for="ReportType" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label>From Date</label>
        <input asp-for="FromDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>To Date</label>
        <input asp-for="ToDate" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
