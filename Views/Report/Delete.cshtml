@model JourneySpire.Models.Report
@{
    ViewData["Title"] = "Delete Report";
    Layout = "_HomeLayout";
}

<h2>Delete Report</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this report?
</div>

<dl class="row">
    <dt class="col-sm-3">Report Type</dt>
    <dd class="col-sm-9">@Model.ReportType</dd>

    <dt class="col-sm-3">Generated On</dt>
    <dd class="col-sm-9">@Model.GeneratedOn</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ReportId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
