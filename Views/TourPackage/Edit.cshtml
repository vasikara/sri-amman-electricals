@model JourneySpire.Models.TourPackage

@{
    ViewData["Title"] = "Edit Tour Package";

    Layout = "_HomeLayout";
}

<h2>Edit Tour Package</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="PackageId" />
    <input type="hidden" asp-for="ImagePath" />

    <div class="mb-3">
        <label>Package Name</label>
        <input asp-for="PackageName" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Location</label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Days</label>
        <input asp-for="Days" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Price</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Current Image</label><br />
        <img src="@Model.ImagePath" width="120" />
    </div>

    <div class="mb-3">
        <label>Change Image</label>
        <input type="file" name="ImageFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
