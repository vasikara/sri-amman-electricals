<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - JourneySpire</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

    <!-- HEADER -->
    <header class="bg-dark text-white py-3">
        <div class="container d-flex justify-content-between align-items-center">

            <!-- LEFT : PROJECT NAME -->
            <h1 class="m-0">JourneySpire</h1>

            <!-- RIGHT : ALL MODULES -->
            <nav class="d-flex align-items-center">

                <a asp-controller="Home" asp-action="Index" class="text-white me-3">
                    Home
                </a>

                <a asp-controller="TourPackage" asp-action="Index" class="text-white me-3">
                    Tour Packages
                </a>

                <a asp-controller="Booking" asp-action="Index" class="text-white me-3">
                    Booking
                </a>

                <a asp-controller="Guide" asp-action="Index" class="text-white me-3">
                    Guides
                </a>

                <a asp-controller="Vehicle" asp-action="Index" class="text-white me-3">
                    Vehicles
                </a>

                <a asp-controller="Customer" asp-action="Index" class="text-white me-3">
                    Customers
                </a>
                <a asp-controller="Payment" asp-action="Index" class="text-white me-3">
                    Payment
                </a>

                <a asp-controller="Feedback" asp-action="Create" class="text-white me-3">
                    Feedback
                </a>

                <a asp-controller="Report" asp-action="Index" class="text-white me-3">
                    Reports
                </a>

                <a asp-controller="Admin" asp-action="Logout"
                   class="btn btn-danger btn-sm">
                    Logout
                </a>

            </nav>

        </div>
    </header>

    <!-- PAGE CONTENT -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="container text-center">
            <p class="mb-1">
                © @DateTime.Now.Year Journey Spire. All Rights Reserved.
            </p>

            <p class="mb-2">
                <i class="fa fa-phone"></i> +91 98765 43210 |
                <i class="fa fa-envelope"></i> journeyspire@gmail.com
            </p>

            <!-- Social Icons -->
            <div>
                <a href="#"><i class="fab fa-facebook fa-lg"></i></a>
                <a href="#"><i class="fab fa-instagram fa-lg"></i></a>
                <a href="#"><i class="fab fa-twitter fa-lg"></i></a>
                <a href="#"><i class="fab fa-linkedin fa-lg"></i></a>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
