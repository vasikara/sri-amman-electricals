@model JourneySpire.Models.Driver

@{
    ViewData["Title"] = "Add Driver";

    Layout = "_HomeLayout";
}

<h2>Add Driver</h2>
<hr />

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Driver Name</label>
        <input asp-for="DriverName" class="form-control" />
        <span asp-validation-for="DriverName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Phone</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">License Number</label>
        <input asp-for="LicenseNumber" class="form-control" />
        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label class="form-check-label">Available</label>
    </div>

    <button type="submit" class="btn btn-success">
        Save
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>
</form>
