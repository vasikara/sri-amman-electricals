@model JourneySpire.Models.Payment

@{
    ViewData["Title"] = "Payment Delete";

    Layout = "_HomeLayout";
}

<h2>Delete Payment</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this payment?
</div>

<table class="table">
    <tr><th>Customer</th><td>@Model.CustomerName</td></tr>
    <tr><th>Package</th><td>@Model.PackageName</td></tr>
    <tr><th>Amount</th><td>@Model.Amount</td></tr>
</table>

<form asp-action="DeleteConfirmed" method="post">
    @Html.HiddenFor(m => m.PaymentId)

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
